{
  "name": "@local/dsh-oks-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "右侧栏的「产出」页签：只读我们自己的服务端接口（`oksArtifacts`），呈现制品而不是文件。",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "test": "node test.mjs"
  }
}
