{
  "name": "@local/dsh-oks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plugin for using an ontology model: querying, analyzing and reporting.",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/index.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "node scripts/run-tests.mjs",
    "check": "pnpm run typecheck && pnpm run test",
    "test:smoke": "node --import ./scripts/markdown-loader.mjs tests/smoke.ts",
    "test:integration": "node --import ./scripts/markdown-loader.mjs tests/dari-adapter-test.ts",
    "snapshot": "node --import ./scripts/markdown-loader.mjs scripts/knowledge-snapshot.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@js-temporal/polyfill": "catalog:",
    "echarts": "catalog:"
  }
}
