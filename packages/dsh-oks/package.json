{
  "name": "@local/dsh-oks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plugin for using an ontology model: querying, analyzing and reporting.",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/index.mjs",
    "lib/oks-wti.wasm",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "scripts": {
    "build": "pnpm run wasm && tsdown",
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "node jaq-test.ts lib/oks-wti.wasm && node smoke.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "saxes": "^6.0.0"
  }
}
