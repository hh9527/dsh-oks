data facts := table([{level:"major",count:3}],{kind:"example"});
data rows := select({from:{f:facts},fields:(r)=>({"告警级别":r.f.level,"数量":r.f.count})});
data winner := select_one({from:{f:facts},fields:(r)=>({level:r.f.level}),order_by:(o)=>[asc(o.level)],limit:1});
data chartSpec := {x:"告警级别",value:"数量"};
data tableSpec := {columns:["告警级别","数量"]};
data summary := select_one({from:{f:facts},group_by:(r)=>({}),fields:(g,rows)=>({total:sum(rows.f.count)})});

figure comparison := ColumnChart(spec = chartSpec, data = rows);

figure details := Table(spec = tableSpec, data = rows);

report answer := Report(title = "呈现示例") [
  h1 [ "示例结果" ],
  p [
    "数量：",
    Value(data = summary?.total),
  ],
  p [
    "首项：",
    Value(data = winner?.level),
  ],
  figure [
    Figure(ref = comparison),
    figcaption [ "类别比较" ],
  ],
  figure [
    Figure(ref = details),
    figcaption [ "明细" ],
  ],
];
